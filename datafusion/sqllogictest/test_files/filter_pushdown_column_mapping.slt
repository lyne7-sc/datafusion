# Nested join and Repartition
statement ok
SET datafusion.optimizer.enable_dynamic_filter_pushdown = true;

query TT
EXPLAIN SELECT a.id AS a_id, b.id AS b_id FROM c LEFT JOIN (a JOIN b ON a.k = b.k) ON c.key = b.id;
----
physical_plan
01)ProjectionExec: expr=[id@0 as a_id, id@1 as b_id]
02)--HashJoinExec: mode=CollectLeft, join_type=Left, on=[(key@0, id@1)], projection=[id@1, id@2]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/c.parquet]]}, projection=[key], file_type=parquet
04)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
05)------HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(k@1, k@1)], projection=[id@0, id@2]
06)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/a.parquet]]}, projection=[id, k], file_type=parquet
07)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/b.parquet]]}, projection=[id, k], file_type=parquet, predicate=DynamicFilter [ empty ] AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible

