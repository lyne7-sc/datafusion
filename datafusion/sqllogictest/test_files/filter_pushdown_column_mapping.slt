# Filter with an embedded projection. The predicate needs a.k, which is not
# selected, so FilterExec retains it in its input and projects [id@0, id@2].
# The parent filter on b_id@1 must therefore map to the input column id@2.
statement ok
SET datafusion.optimizer.enable_dynamic_filter_pushdown = true;

query TT
EXPLAIN SELECT x.a_id, x.b_id FROM c LEFT JOIN (SELECT a.id AS a_id, b.id AS b_id FROM a LEFT JOIN b ON a.k = b.k WHERE a.k > 0 OR b.id > 0) x ON c.key = x.b_id;
----
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Left, on=[(key@0, b_id@1)], projection=[a_id@1, b_id@2]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/c.parquet]]}, projection=[key], file_type=parquet
03)--ProjectionExec: expr=[id@0 as a_id, id@1 as b_id]
04)----FilterExec: k@1 > 0 OR id@2 > 0, projection=[id@0, id@2]
05)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)--------HashJoinExec: mode=CollectLeft, join_type=Left, on=[(k@1, k@1)], projection=[id@0, k@1, id@2]
07)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/a.parquet]]}, projection=[id, k], file_type=parquet
08)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/b.parquet]]}, projection=[id, k], file_type=parquet, predicate=DynamicFilter [ empty ], dynamic_rg_pruning=eligible

