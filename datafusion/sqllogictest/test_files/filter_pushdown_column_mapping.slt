# A parent dynamic filter must cross two joins with reordered output columns.
statement ok
SET datafusion.optimizer.enable_dynamic_filter_pushdown = true;

query TT
EXPLAIN SELECT y.a_id, y.b_id FROM d JOIN (SELECT x.a_id, x.b_id FROM c JOIN (SELECT b.id AS b_id, a.id AS a_id FROM a JOIN b ON a.k = b.k) x ON c.key = x.b_id) y ON d.key = y.b_id + 1;
----
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(CAST(d.key AS Int64)@1, y.b_id + Int64(1)@2)], projection=[a_id@2, b_id@3]
