# Keep both z columns in a real scan: the residual join condition needs z.id,
# while the equijoin uses z.key. Their different values expose name-based remapping.
query I
COPY (SELECT 0::INT AS id, 1::INT AS key) TO 'test_files/scratch/filter_pushdown_column_mapping/z.parquet' STORED AS PARQUET;
----
1

statement ok
CREATE EXTERNAL TABLE z STORED AS PARQUET LOCATION 'test_files/scratch/filter_pushdown_column_mapping/z.parquet';

# Left semi join with a differently named key
statement ok
SET datafusion.optimizer.enable_dynamic_filter_pushdown = true;

query TT
EXPLAIN SELECT c.key, x.id FROM c JOIN (SELECT a.id FROM a LEFT SEMI JOIN z ON a.id = z.key AND z.id < a.k) x ON c.key = x.id + 99;
----
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(CAST(c.key AS Int64)@1, x.id + Int64(99)@1)], projection=[key@0, id@2]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/c.parquet]]}, projection=[key, CAST(key@0 AS Int64) as CAST(c.key AS Int64)], file_type=parquet
03)--ProjectionExec: expr=[id@0 as id, CAST(id@0 AS Int64) + 99 as x.id + Int64(99)]
04)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
05)------HashJoinExec: mode=CollectLeft, join_type=LeftSemi, on=[(id@0, key@1)], filter=id@1 < k@0, projection=[id@0]
06)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/a.parquet]]}, projection=[id, k], file_type=parquet, predicate=DynamicFilter [ empty ], dynamic_rg_pruning=eligible
07)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/filter_pushdown_column_mapping/z.parquet]]}, projection=[id, key], file_type=parquet, predicate=DynamicFilter [ empty ] AND DynamicFilter [ empty ], dynamic_rg_pruning=eligible

